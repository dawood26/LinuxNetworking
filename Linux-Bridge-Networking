ip netns exec ns1 ip addr add 192.168.1.1/24 dev vth_1
ip netns exec ns1 ip route add 192.168.124.0/24 via 192.168.1.50
ip link set vth1 master br0
ip link set vth1 up
ip netns exec ns1 ip link set vth_1 up
#bridge vlan add vid 10 dev vth1 pvid untagged master
