#!/bin/bash
#create the bridge - Br0
ip link add name br0 type bridge
ip addr add 192.168.1.50/24 dev br0
ip link set dev br0 type bridge vlan_filtering 1
#bridge vlan add vid 10 dev br0 pvid untagged self
#bridge vlan add vid 20 dev br0 pvid untagged self
#####
ip netns add ns1
ip link add name vth1 type veth peer name vth_1
